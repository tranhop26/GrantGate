{
  "name": "grantgate",
  "private": true,
  "version": "0.1.0",
  "description": "Validator-enforced software grant milestones on GenLayer",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @grantgate/shared build && pnpm --filter @grantgate/web build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --sequential test",
    "test:contract": "pnpm --filter @grantgate/contracts test",
    "test:shared": "pnpm --filter @grantgate/shared test",
    "test:web": "pnpm --filter @grantgate/web test",
    "lint": "eslint . && pnpm lint:genvm",
    "lint:web": "eslint apps/web/src packages/shared/src packages/contracts/scripts",
    "lint:genvm": "cross-env PYTHONUTF8=1 genvm-lint check packages/contracts/grantgate.py",
    "deploy:contract": "node packages/contracts/scripts/deploy.mjs",
    "e2e:live": "node packages/contracts/scripts/e2e.mjs"
  },
  "packageManager": "pnpm@10.18.2",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "globals": "^17.11.0",
    "typescript-eslint": "^8.67.0"
  }
}
